<!doctype html>
<html lang="hi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GitHub Push Form</title>
<style>
  body{font-family:system-ui,sans-serif;background:#f6f8fa;margin:0;padding:24px;color:#24292f}
  form{max-width:560px;margin:auto;background:#fff;border:1px solid #d0d7de;border-radius:8px;padding:24px}
  h2{margin-top:0}
  label{display:block;margin:14px 0 4px;font-weight:600;font-size:14px}
  input,textarea{width:100%;box-sizing:border-box;padding:8px;border:1px solid #d0d7de;border-radius:6px;font:inherit}
  textarea{min-height:140px;font-family:ui-monospace,monospace}
  .row{display:flex;gap:12px}.row>div{flex:1}
  button{margin-top:18px;background:#2da44e;color:#fff;border:0;border-radius:6px;padding:10px 18px;font-size:15px;cursor:pointer}
  button:disabled{opacity:.6}
  #out{margin-top:14px;font-size:14px;white-space:pre-wrap}
  .ok{color:#1a7f37}.err{color:#cf222e}
  small{color:#57606a}
</style>
</head>
<body>
<form id="f">
  <h2>GitHub par Push karein</h2>

  <label>Personal Access Token</label>
  <input type="password" id="token" placeholder="ghp_... ya github_pat_..." required>
  <small>Token sirf aapke browser mein rehta hai, GitHub API ko hi bheja jata hai. Scope: <b>repo</b> (Contents: write).</small>

  <div class="row">
    <div><label>Owner / Username</label><input id="owner" required></div>
    <div><label>Repository</label><input id="repo" required></div>
  </div>

  <div class="row">
    <div><label>Branch</label><input id="branch" value="main" required></div>
    <div><label>File path</label><input id="path" placeholder="src/index.js" required></div>
  </div>

  <label>Commit message</label>
  <input id="msg" value="Add file via web form" required>

  <label>File content (text)</label>
  <textarea id="content" placeholder="Yahan code/text likhein..."></textarea>

  <label>ya file upload karein (upload karne par upar wala text ignore hoga)</label>
  <input type="file" id="file">

  <button id="btn" type="submit">Push to GitHub</button>
  <div id="out"></div>
</form>

<script>
const $ = id => document.getElementById(id);

const toB64Text = s => {
  const bytes = new TextEncoder().encode(s);
  let bin = ""; bytes.forEach(b => bin += String.fromCharCode(b));
  return btoa(bin);
};
const fileToB64 = f => new Promise((res, rej) => {
  const r = new FileReader();
  r.onload = () => res(r.result.split(",")[1]);
  r.onerror = rej;
  r.readAsDataURL(f);
});

$("f").addEventListener("submit", async e => {
  e.preventDefault();
  const out = $("out"), btn = $("btn");
  out.className = ""; out.textContent = "Push ho raha hai...";
  btn.disabled = true;

  try {
    const owner = $("owner").value.trim(), repo = $("repo").value.trim();
    const branch = $("branch").value.trim();
    const path = $("path").value.trim().replace(/^\/+/, "");
    const url = `https://api.github.com/repos/${owner}/${repo}/contents/${path.split("/").map(encodeURIComponent).join("/")}`;
    const headers = {
      "Authorization": "Bearer " + $("token").value.trim(),
      "Accept": "application/vnd.github+json",
      "X-GitHub-Api-Version": "2022-11-28"
    };

    const file = $("file").files[0];
    const content = file ? await fileToB64(file) : toB64Text($("content").value);

    // Agar file pehle se hai to uska sha chahiye (update ke liye)
    let sha;
    const check = await fetch(`${url}?ref=${encodeURIComponent(branch)}`, { headers });
    if (check.ok) sha = (await check.json()).sha;

    const res = await fetch(url, {
      method: "PUT",
      headers: { ...headers, "Content-Type": "application/json" },
      body: JSON.stringify({ message: $("msg").value, content, branch, ...(sha && { sha }) })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.message || res.status);

    out.className = "ok";
    out.textContent = (sha ? "File update ho gayi ✓\n" : "File create ho gayi ✓\n") + data.content.html_url;
  } catch (err) {
    out.className = "err";
    out.textContent = "Error: " + err.message;
  } finally {
    btn.disabled = false;
  }
});
</script>
</body>
</html>
